# Copy to .env (gitignored). All variables use the FUT_ prefix.
# Lists/tuples are JSON: FUT_UNIVERSE='["BTCUSDT","ETHUSDT"]'

FUT_DATA_DIR=data
FUT_HISTORY_START=2021-01-01
# FUT_UNIVERSE='["BTCUSDT","ETHUSDT","SOLUSDT","BNBUSDT","XRPUSDT","DOGEUSDT"]'
# FUT_INTERVALS='["1m"]'
# FUT_DATASETS='["klines","markPriceKlines"]'
FUT_DOWNLOAD_WORKERS=4

# Signed endpoints default to TESTNET. Mainnet needs BOTH lines below plus a mainnet URL,
# and is out of scope until explicitly requested.
FUT_TRADING_ENV=testnet
FUT_TRADING_URL=https://testnet.binancefuture.com
# FUT_ENABLE_MAINNET=false

# Testnet API key. Never enable withdrawals on any key. Leave empty if not needed.
FUT_API_KEY=
FUT_API_SECRET=
